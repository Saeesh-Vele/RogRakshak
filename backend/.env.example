# Supabase PostgreSQL Direct Connection URI (Supabase Dashboard -> Settings -> Database -> Connection String -> URI [Direct])
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=SWASTIK%402012SAEESH@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model for lab-report extraction. Pinned to the version the extraction
# oracle was validated against — do not switch to a floating alias (e.g.
# gemini-flash-latest) without re-validating against data/lab_reports/.
GEMINI_MODEL=gemini-2.5-flash

# CORS: comma-separated origins allowed to call this API.
# Must match the frontend dev server origin (`next dev` defaults to port 3000).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
