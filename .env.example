# Supabase PostgreSQL Direct Connection URI (Supabase Dashboard -> Settings -> Database -> Connection String -> URI [Direct])
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Neo4j Graph Database for temporal interaction & contact graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Google Gemini API Key for LangGraph multi-agent reasoning
GOOGLE_API_KEY=your_gemini_api_key_here

# Frontend API URL (Backend endpoint)
NEXT_PUBLIC_API_URL=http://localhost:8000
