# Credentials for scripts/create_doctor.py — LOCAL ONLY, never committed.
# Copy to scripts/.env.local and fill in.
#
# Supabase Dashboard -> Project Settings -> API
#
# SUPABASE_SECRET_KEY is the *secret* / service_role key, not the publishable
# (anon) one. It bypasses row-level security entirely. It is intentionally not
# prefixed with NEXT_PUBLIC_ and lives outside frontend/, so Next.js never reads
# it and it can never be inlined into the browser bundle.

SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key_here
